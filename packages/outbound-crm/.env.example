# Outbound CRM - Credentials Configuration
# Copy this file to .env and fill in the values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real values
#   node tests/e2e-test.js

# ============================================================
# REQUIRED: Core Services
# ============================================================

# N8N Instance
N8N_URL=https://your-n8n-instance.com
N8N_API_KEY=your-n8n-api-key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# N8N Credential IDs (created in N8N UI after setting up credentials)
# These are the internal N8N IDs for stored credentials
SUPABASE_CREDENTIAL_ID=
RESEND_CREDENTIAL_ID=

# ============================================================
# REQUIRED: Email Sending (Resend)
# ============================================================

RESEND_API_KEY=re_xxxxxxxxxxxxx

# ============================================================
# OPTIONAL: Enrichment APIs
# ============================================================

# Hunter.io - Email finding
HUNTER_API_KEY=

# Email validation (NeverBounce or ZeroBounce)
VALIDATION_API_KEY=

# ============================================================
# OPTIONAL: Notifications
# ============================================================

# Slack webhook, email, or custom endpoint for alerts
NOTIFICATION_WEBHOOK_URL=

# ============================================================
# OPTIONAL: Reply handling (IMAP)
# ============================================================

# IMAP settings for WF-05 Reply Handler
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_SETTINGS=

# ============================================================
# TEST CONFIGURATION
# ============================================================

# Email address for test sends (will receive test emails)
TEST_EMAIL=test@test.leveron.com

# N8N webhook URL for the tracking edge function to forward events
N8N_TRACKING_WEBHOOK_URL=

{
  "name": "Lead Capture - Webhook to CRM + Slack Notification",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook - New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "parameters": {
        "path": "new-lead",
        "httpMethod": "POST",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "lead-capture-hook"
    },
    {
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Validate Lead Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json.email. }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "cond-002",
              "leftValue": "={{ $json.name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Enrich Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [720, 200],
      "parameters": {
        "url": "https://api.clearbit.com/v2/people/find?email={$json.email}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Format Lead for CRM",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [960, 200],
      "parameters": {
        "functionCode": "const lead = ={{ $json }};\nconst enriched = $('Enrich Lead').item.json;\n\nreturn [{\n  json: {\n    name: lead.name,\n    email: lead.email,\n    phone: lead.phone || '',\n    company: enriched.company?.name || 'Unknown',\n    title: enriched.title || '',\n    source: 'webhook',\n    created_at: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.1,
      "position": [1200, 200],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1200, 400],
      "parameters": {
        "channel": "#leads",
        "text": "={{ }} New lead captured!\n\nName: ={{ $node.Format Lead for CRM.json.name }}\nEmail: ={{ $json.email }}\nCompany: ={{ $json.company }}\nSource: ={{ $json.source }}",
        "otherOptions": {}
      }
    },
    {
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Send Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 420],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"Invalid lead data. Email and name are required.\", \"status\": 400 } }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Send Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"Lead captured\", \"id\": $json.id } }}",
        "options": {
          "responseCode": 201
        }
      }
    },
    {
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "Process Notes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 500],
      "parameters": {
        "jsCode": "// Clean and format notes\nconst items = $input.all();\nconst result = items.map(item => {\n  const notes = ={{ $json.notes }};\n  return {\n    json: {\n      ...item.json,\n      notes: notes?.trim() || 'No notes provided'\n    }\n  };\n});\nreturn result;"
      }
    },
    {
      "id": "a1b2c3d4-0010-4000-8000-000000000010",
      "name": "Old Start Node",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [50, 600],
      "parameters": {}
    },
    {
      "id": "a1b2c3d4-0011-4000-8000-000000000011",
      "name": "Debug Logger",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [300, 600],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "debug_api_key",
              "value": "sk-proj-abc123def456ghi789jkl012mno345pqr678stu901",
              "type": "string"
            },
            {
              "name": "debug_timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0012-4000-8000-000000000012",
      "name": "Batch Processor",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [500, 600],
      "parameters": {
        "batchSize": 10,
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0013-4000-8000-000000000013",
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [100, 100],
      "parameters": {
        "content": "## Lead Capture Workflow\nCaptures leads from webhook, validates, enriches via Clearbit, saves to Google Sheets, and notifies Slack.",
        "width": 400,
        "height": 120
      }
    },
    {
      "id": "a1b2c3d4-0014-4000-8000-000000000014",
      "name": "Floating Node",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [1600, 600],
      "parameters": {}
    }
  ],
  "connections": {
    "Webhook - New Lead": {
      "main": [
        [{ "node": "Validate Lead Data", "type": "main", "index": 0 }]
      ]
    },
    "Validate Lead Data": {
      "main": [
        [{ "node": "Enrich Lead", "type": "main", "index": 0 }],
        [{ "node": "Send Error Response", "type": "main", "index": 0 }]
      ]
    },
    "Enrich Lead": {
      "main": [
        [
          { "node": "Format Lead for CRM", "type": "main", "index": 0 },
          { "node": "Notify Slack", "type": "main", "index": 0 }
        ]
      ]
    },
    "Format Lead for CRM": {
      "main": [
        [{ "node": "Save to Google Sheets", "type": "main", "index": 0 }]
      ]
    },
    "Save to Google Sheets": {
      "main": [
        [{ "node": "Send Success Response", "type": "main", "index": 0 }]
      ]
    },
    "Old Start Node": {
      "main": [
        [{ "node": "Debug Logger", "type": "main", "index": 0 }]
      ]
    },
    "Debug Logger": {
      "main": [
        [{ "node": "Batch Processor", "type": "main", "index": 0 }]
      ]
    },
    "Deleted Node Reference": {
      "main": [
        [{ "node": "Also Deleted", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false
}
